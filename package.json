{
  "name": "rcm",
  "version": "1.0.0",
  "private": true,
  "description": "Revenue Cycle Management Application",
  "packageManager": "yarn@4.2.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -ptA run build",
    "clean": "yarn workspaces foreach -ptA run clean",
    "lint": "eslint .",
    "type-check": "yarn workspaces foreach -ptA run type-check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3"
  }
}
