{
  "name": "@rcm/migrations",
  "version": "1.0.0",
  "description": "Database migrations for Revenue Cycle Management",
  "type": "module",
  "scripts": {
    "migrate": "node-pg-migrate -f .node-pg-migrate.config.json",
    "migrate:up": "node-pg-migrate up -f .node-pg-migrate.config.json",
    "migrate:down": "node-pg-migrate down -f .node-pg-migrate.config.json",
    "migrate:create": "node-pg-migrate create -m src/migrations",
    "build": "rm -f tsconfig.tsbuildinfo && tsc && rm -f dist/migrations/*.d.ts*",
    "clean": "rm -rf dist",
    "seed": "node dist/seeds/seed.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
